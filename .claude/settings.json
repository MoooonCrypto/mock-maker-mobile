{
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(sudo:*)",

      // 危険な削除系
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(del:*)",

      // Git操作禁止（人間がやる）
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git merge:*)",

      // パッケージ管理禁止（依存追加削除は手動）
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm remove:*)",
      "Bash(yarn add:*)",
      "Bash(yarn remove:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(expo install:*)",
      "Bash(expo prebuild:*)",
      "Bash(npx expo install:*)",
      "Bash(npx expo prebuild:*)",

      // ビルド・実行系も禁止（ユーザー管理）
      "Bash(npx expo run:*)",
      "Bash(npx expo build:*)",
      "Bash(eas build:*)",

      // 外部通信系禁止
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",

      // DB接続禁止
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(mongod:*)",

      // 親ディレクトリ操作禁止
      "Read(../*)",
      "Read(../../*)",
      "Write(../*)",
      "Write(../../*)",

      // 機密情報保護
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*token*)",
      "Read(**/*key*)",
      "Read(**/*secret*)",

      "Write(.env*)",
      "Write(**/secrets/**)",

      // ロックファイル・依存定義変更禁止
      "Write(package.json)",
      "Write(package-lock.json)",
      "Write(yarn.lock)",
      "Write(pnpm-lock.yaml)"
    ]
  }
}