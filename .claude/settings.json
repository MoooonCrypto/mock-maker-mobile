{
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(sudo:*)",

      
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(del:*)",

      
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git merge:*)",

      
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm remove:*)",
      "Bash(yarn add:*)",
      "Bash(yarn remove:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(expo install:*)",
      "Bash(expo prebuild:*)",
      "Bash(npx expo install:*)",
      "Bash(npx expo prebuild:*)",

      
      "Bash(npx expo run:*)",
      "Bash(npx expo build:*)",
      "Bash(eas build:*)",

      
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",

      
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(mongod:*)",

      
      "Read(../*)",
      "Read(../../*)",
      "Write(../*)",
      "Write(../../*)",

      
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*token*)",
      "Read(**/*key*)",
      "Read(**/*secret*)",

      "Write(.env*)",
      "Write(**/secrets/**)",

      
      "Write(package.json)",
      "Write(package-lock.json)",
      "Write(yarn.lock)",
      "Write(pnpm-lock.yaml)"
    ]
  }
}