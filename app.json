{
  "expo": {
    "name": "MockMaker",
    "slug": "mock-maker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "mockmaker",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2b8cee"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mockmaker.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Used to save mockup images to your photo library. / モックアップ画像をフォトライブラリに保存するために使用します。",
        "NSPhotoLibraryAddUsageDescription": "Used to save mockup images to your photo library. / モックアップ画像をフォトライブラリに保存するために使用します。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2b8cee"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mockmaker.mobile",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-2543814564794464~9655022649"
        }
      ],
      "expo-dev-client",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This app uses anonymous ad tracking to display relevant ads. Declining will not affect app functionality. / 広告表示のために匿名のトラッキングを使用します。拒否してもアプリの機能に影響はありません。"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Used to save mockup images and videos to your photo library. / モックアップ画像・動画をフォトライブラリに保存するために使用します。",
          "savePhotosPermission": "Used to save mockup images and videos to your photo library. / モックアップ画像・動画をフォトライブラリに保存するために使用します。",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to select images and videos for your mockup. / モックアップ用の画像・動画を選択するために使用します。"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "407f1d38-7375-42be-972e-59d809de8664"
      }
    }
  }
}
